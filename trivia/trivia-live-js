/* =========================================================
   DIONLYONEE PLAYGROUND
   TRIVIA LIVE SCREEN
   ========================================================= */

import {

  getTimerRemaining

} from "./trivia-engine.js";


import {

  subscribeToRoom

} from "../shared/firebase-room.js";


let roomCode =
null;


let gameState =
null;


let unsubscribe =
null;


/* =========================================================
   GET ROOM CODE FROM URL

   Example:

   trivia-live.html?room=ABC123
   ========================================================= */

const params =
new URLSearchParams(
  window.location.search
);


roomCode =
params.get("room")
  ?.trim()
  .toUpperCase();


/* =========================================================
   ELEMENTS
   ========================================================= */

const waitingScreen =
document.getElementById(
"live-waiting"
);

const gameScreen =
document.getElementById(
"live-game"
);


const roundDisplay =
document.getElementById(
"live-round"
);

const categoryDisplay =
document.getElementById(
"live-category"
);

const difficultyDisplay =
document.getElementById(
"live-difficulty"
);

const timerDisplay =
document.getElementById(
"live-timer"
);

const questionDisplay =
document.getElementById(
"live-question"
);

const optionsDisplay =
document.getElementById(
"live-options"
);

const answerPanel =
document.getElementById(
"live-answer-panel"
);

const answerDisplay =
document.getElementById(
"live-answer"
);

const winnerDisplay =
document.getElementById(
"live-winner"
);

const messageDisplay =
document.getElementById(
"live-message"
);


/* =========================================================
   START
   ========================================================= */

if (!roomCode) {

  console.warn(
    "No room code provided."
  );


} else {

  connectToRoom();

}


function connectToRoom() {

  unsubscribe =
    subscribeToRoom(

      roomCode,

      room => {

        if (
          !room?.gameState
        ) {

          showWaiting();

          return;

        }


        gameState =
          room.gameState;


        render();

      }

    );

}


/* =========================================================
   WAITING SCREEN
   ========================================================= */

function showWaiting() {

  waitingScreen.hidden =
    false;


  gameScreen.hidden =
    true;

}


function showGame() {

  waitingScreen.hidden =
    true;


  gameScreen.hidden =
    false;

}


/* =========================================================
   RENDER
   ========================================================= */

function render() {

  if (!gameState) {

    showWaiting();

    return;

  }


  showGame();


  roundDisplay.textContent =
    `ROUND ${gameState.round}`;


  categoryDisplay.textContent =
    gameState.currentQuestion?.category ||
    gameState.category ||
    "TRIVIA";


  difficultyDisplay.textContent =
    (
      gameState.currentQuestion?.difficulty ||
      gameState.difficulty ||
      ""
    ).toUpperCase();


  timerDisplay.textContent =
    `${getTimerRemaining(
      gameState
    )}`;


  messageDisplay.textContent =
    gameState.message ||
    "";


  renderQuestion();


  renderWinner();


  renderAnswer();

}


function renderQuestion() {

  if (
    !gameState.currentQuestion
  ) {

    questionDisplay.textContent =
      "GET READY FOR THE NEXT QUESTION!";


    optionsDisplay.innerHTML =
      "";

    return;

  }


  const question =
    gameState.currentQuestion;


  questionDisplay.textContent =
    question.question;


  optionsDisplay.innerHTML =
    "";


  question.options.forEach(

    (option, index) => {

      const optionElement =
        document.createElement(
          "div"
        );


      optionElement.className =
        "live-trivia-option";


      const letter =
        String.fromCharCode(
          65 + index
        );


      optionElement.innerHTML =

        `<span class="option-letter">${letter}</span>
         <span>${option}</span>`;


      optionsDisplay.appendChild(
        optionElement
      );

    }

  );

}


function renderAnswer() {

  if (
    gameState.status ===
    "answer_reveal" &&
    gameState.currentQuestion
  ) {

    answerPanel.hidden =
      false;


    answerDisplay.textContent =
      gameState.currentQuestion.answer;


  } else {

    answerPanel.hidden =
      true;

  }

}


function renderWinner() {

  if (
    gameState.winner
  ) {

    winnerDisplay.hidden =
      false;


    winnerDisplay.textContent =

      `🏆 ${gameState.winner.toUpperCase()} WINS! 🏆`;


  } else {

    winnerDisplay.hidden =
      true;

  }

}


/* =========================================================
   LIVE TIMER

   Firebase stores the start timestamp.

   Every screen calculates the timer independently,
   which keeps the Host, Cohost, and Live Screen
   synchronized.
   ========================================================= */

setInterval(

  () => {

    if (
      gameState
    ) {

      const seconds =
        getTimerRemaining(
          gameState
        );


      timerDisplay.textContent =
        seconds;


      if (
        seconds <= 5 &&
        seconds > 0
      ) {

        timerDisplay.classList.add(
          "timer-warning"
        );

      } else {

        timerDisplay.classList.remove(
          "timer-warning"
        );

      }


      if (
        seconds === 0 &&
        gameState.timerRunning
      ) {

        timerDisplay.classList.add(
          "timer-finished"
        );

      }

    }

  },

  100

);